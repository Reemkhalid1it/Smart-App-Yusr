# ─────────────────────────────────────────────────────────────
# Yusr — .gitignore (reviewed for public publication)
# Based on the Flutter template, extended for secrets and tooling.
# ─────────────────────────────────────────────────────────────

# ── Secrets and private configuration ────────────────────────
# Keys, tokens, signing material. NEVER commit these.
.env
.env.*
!.env.example
dart_defines*.json
!dart_defines.example.json
secrets.xcconfig
**/Secrets.xcconfig
service-account*.json
*-service-account*.json
*.pem
*.p8
*.p12
*.mobileprovision
key.properties
**/key.properties
*.jks
*.keystore

# ── Firebase / FlutterFire project configuration ─────────────
# Generated per developer with `flutterfire configure`.
# Contains your project and app IDs and client API keys.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist
lib/firebase_options.dart
firebase.json
.firebaserc
firebase-debug.log
firestore-debug.log
.firebase/

# ── Machine-specific files ───────────────────────────────────
# Contains local SDK paths (and may contain API keys if you add them).
local.properties
**/local.properties

